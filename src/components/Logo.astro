<style>
  .logo {
    display: flex;
    width: 100px;
    height: 100px;
    align-items: center;
    justify-content: center;
  }

  .logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .logo img.logo-dark {
    display: none;
  }

  :global(html.theme-dark) .logo img.logo-light {
    display: none;
  }

  :global(html.theme-dark) .logo img.logo-dark {
    display: block;
  }

  @media screen and (max-width: 480px) {
    .logo {
      padding: 0.33em 0.67em;
      width: 75px;
      height: 75px;
    }
  }
</style>

<a href="/" class="logo" aria-label="Home">
  <img class="logo-light" src="/assets/logo.svg" alt="" width="100" height="100" />
  <img class="logo-dark" src="/assets/logo-dark.svg" alt="" width="100" height="100" />
</a>
